# repo root: /.gitignore

# Virtual environments (in case any exist at root level)
venv/
.venv/
env/

# Python cache/bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# OS-specific junk
.DS_Store
Thumbs.db

# Editor/IDE settings
.vscode/
.idea/

# Environment variable files (secrets, API keys, etc.)
.env
*.env.local

# Jupyter checkpoints (if any project uses notebooks)
.ipynb_checkpoints/

# General log files
*.log