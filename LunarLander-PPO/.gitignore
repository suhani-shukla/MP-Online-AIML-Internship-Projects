# LunarLander-PPO/.gitignore

# Trained models -- large binaries, excluded by default
models/*.zip
!models/.gitkeep

models/checkpoints/*
!models/checkpoints/.gitkeep

models/best_model/*
!models/best_model/.gitkeep

# Training/monitor logs
logs/*
!logs/.gitkeep

# Recorded videos
videos/*.mp4
!videos/.gitkeep

# Generated plots/graphs
graphs/*.png
!graphs/.gitkeep

# Python cache
__pycache__/
*.pyc