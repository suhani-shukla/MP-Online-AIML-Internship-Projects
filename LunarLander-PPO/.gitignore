# LunarLander-PPO/.gitignore

# Project-specific virtual environment (if each project has its own now)
venv/
.venv/

# Trained models -- large binaries, excluded by default
models/*.zip
!models/.gitkeep

# Training/monitor logs -- regenerated by train.py, not meant to be tracked
logs/*
!logs/.gitkeep

# Recorded videos -- large binaries, excluded by default
videos/*.mp4
!videos/.gitkeep

# Generated plots/graphs -- regenerated by plot_results.py
graphs/*.png
!graphs/.gitkeep

# Python cache
__pycache__/
*.pyc